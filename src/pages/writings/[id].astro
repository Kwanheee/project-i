---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { loadGraph, type Writing } from '../../lib/data';
import { u, ideaUrl } from '../../lib/url';

export async function getStaticPaths() {
  const writings = await getCollection('writings');
  return writings.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: Writing;
}
const { entry } = Astro.props;
const g = await loadGraph();
const { Content } = await render(entry);
const materials = entry.data.materials.map((m) => g.ideaById.get(m.id)).filter((i): i is NonNullable<typeof i> => !!i);
const fmt = (d?: Date) => (d ? d.toISOString().slice(0, 10) : '');
---

<Base title={entry.data.title}>
  <a class="back" href={u('writings/')}>← 글</a>
  <h1>{entry.data.title}</h1>
  <div class="meta chips">
    <span class="badge">{entry.data.status}</span>
    {entry.data.date && <span>{fmt(entry.data.date)}</span>}
    {entry.data.venue && <span>{entry.data.venue}</span>}
  </div>
  {entry.data.summary && <p class="lede" style="margin-top: 12px">{entry.data.summary}</p>}

  <div class="prose">
    <Content />
  </div>

  {
    materials.length > 0 && (
      <>
        <h2>재료가 된 생각 <span class="badge">{materials.length}</span></h2>
        <ul class="list">
          {materials.map((i) => (
            <li>
              <a class="title" href={ideaUrl(i.id)}>{i.data.question}</a>
              {i.data.claim && <p class="claim">{i.data.claim}</p>}
            </li>
          ))}
        </ul>
      </>
    )
  }
</Base>
